# Docker Compose configuration.
# Copy to .env (`cp .env.example .env`). Never commit .env.
# Every value here is a local-demo placeholder, not a real credential.

# --- PostgreSQL ---
POSTGRES_USER=ridebooking
# Used inside a postgres:// URL by the backend; avoid URL-special characters (@ : / ? #) or URL-encode them.
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ridebooking
# Host port for Postgres. Change it if 5432 is already taken on your machine.
POSTGRES_HOST_PORT=5432

# --- Backend (Nest.js) ---
# Host port for the API. If you change it, update NEXT_PUBLIC_API_BASE_URL to match.
BACKEND_HOST_PORT=3001
LOG_LEVEL=info
# Origins allowed to call the API from a browser. Must include the frontend's URL
# (update it if you change FRONTEND_HOST_PORT).
CORS_ORIGINS=http://localhost:3000
# Seeded drivers don't stream GPS, so the demo uses a long freshness window (production: ~120 s).
DRIVER_LOCATION_TTL_SECONDS=86400

# --- Frontend (Next.js) ---
# Host port for the web app. If you change it, add the new origin to CORS_ORIGINS.
FRONTEND_HOST_PORT=3000
# Inlined into the browser bundle at *build* time (a Docker build arg), so changing it needs
# `docker compose up --build`. Must be reachable from the browser, not from inside Docker.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
