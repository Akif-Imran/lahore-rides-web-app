            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "rider": []
          },
          {
            "driver": []
          }
        ],
        "summary": "Get a ride",
        "tags": [
          "rides"
        ]
      }
