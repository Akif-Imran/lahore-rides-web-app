    "/api/v1/rides": {
      "post": {
        "description": "Quotes the fare, estimates the pickup ETA and creates a REQUESTED ride. Safe to retry with the same Idempotency-Key: the original response is replayed and no second ride is created.",
        "operationId": "RidesController_create",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "UUID generated once per ride request; reuse it when retrying the same request.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRideDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replay of an earlier request with the same Idempotency-Key",
            "headers": {
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "example": "true"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RideResponseDto"
                }
              }
            }
          },
          "201": {
            "description": "Ride requested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RideResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR: invalid input (see details.fields)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED: missing or unknown X-Rider-Id / X-Driver-Id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: the caller may not perform this action",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "ACTIVE_RIDE_EXISTS: the rider already has an active ride (details.activeRideId)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "IDEMPOTENCY_KEY_REUSED: same key, different request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: retry after the Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "rider": []
          }
        ],
        "summary": "Request a ride",
        "tags": [
          "rides"
        ]
      }
    },
