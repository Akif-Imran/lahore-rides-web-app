# Backend configuration for running on the host (npm run start:dev, tests, migrations).
# Copy to backend/.env. Never commit .env. Values are local placeholders only.
# Inside Docker Compose these are set by docker-compose.yml from the root .env instead.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

DATABASE_URL=postgres://ridebooking:change_me@localhost:5432/ridebooking
# Used only by integration tests; created by docker/postgres/init on first start.
TEST_DATABASE_URL=postgres://ridebooking:change_me@localhost:5432/ridebooking_test
DB_POOL_MAX=10
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=5000

CORS_ORIGINS=http://localhost:3000

# Service area (Lahore) as minLat,minLng,maxLat,maxLng
SERVICE_AREA_BBOX=31.35,74.10,31.70,74.55
MAX_OFFER_RADIUS_KM=5
# Seeded drivers don't stream GPS, so the demo uses a long freshness window (production: ~120).
DRIVER_LOCATION_TTL_SECONDS=86400

RIDE_REQUEST_TTL_SECONDS=300
RIDE_EXPIRY_SWEEP_ENABLED=true

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120
RATE_LIMIT_CREATE_RIDE_LIMIT=10
